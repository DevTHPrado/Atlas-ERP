# ──────────────────────────────────────────────
# ERP Pequenas Empresas — Environment Variables
# ──────────────────────────────────────────────

# Application
APP_NAME=ERP Pequenas Empresas
APP_ENV=local
APP_DEBUG=true

# API
API_V1_PREFIX=/api/v1
SECRET_KEY=change-me-in-production-min-16-chars
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database
DATABASE_URL=postgresql+psycopg://erp:erp@postgres:5432/erp

# Redis
REDIS_URL=redis://redis:6379/0

# CORS
BACKEND_CORS_ORIGINS=http://localhost:3000

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
